# Copy to terraform.tfvars and replace this example URL with your repository URL.
# It must be publicly readable because cloud-init clones it without credentials.
repository_url = "https://github.com/your-name/docker-projekti.git"

# Optionally override the defaults:
# aws_region       = "eu-north-1"
# instance_type    = "t3.small"
# repository_branch = "main"
